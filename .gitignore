# Course material is not ours to commit, and the homework folders
# carry student ID numbers. Only the generated pages and the pipeline go in.
*.pdf
_build/render/
_build/*.png
_build/scratch/
__pycache__/
_build/private/

# ---- Public repo = code only. Course content belongs to the course/lecturer:
/*.html
/site/
_build/*.body.html
_build/*_assets.json
_build/*_assets_review.jpg
_build/src_pdf/
_build/make_mock2.py
_build/patch_round2.py
_build/patch_round3.py
# Holds the Supabase project URL + key; a public repo should not advertise them.
_build/site.json
# Generated by make_site.py; carries the Supabase project URL in its CSP.
/netlify.toml
